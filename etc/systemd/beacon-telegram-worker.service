[Unit]
Description=Beacon Telegram worker
After=network.target

[Service]
Type=simple
User=beacon
Group=beacon
WorkingDirectory=/var/www/beacon

Environment=BEACON_CONFIG_FILE=/etc/beacon/beacon.conf
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 -m app.telegram_worker

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
