[Unit]
Description=Beacon Scheduler service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=beacon
Group=beacon

WorkingDirectory=/var/www/beacon

Environment=BEACON_CONFIG_FILE=/etc/beacon/beacon.conf
Environment=BEACON_SERVICE=scheduler
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 -m app.scheduler_worker

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
